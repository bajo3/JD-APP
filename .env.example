# Valores de ejemplo solamente. Copiar a .env.local para desarrollo local o
# configurarlos como variables protegidas en Vercel. Nunca versionar secretos.
PANEL_ALLOWED_EMAILS=equipo@dominio-confirmado.example
# IDs exactos de cuentas internas autorizadas, separados por comas. Requiere
# coincidencia simultánea con PANEL_ALLOWED_EMAILS; no se aprueban cuentas por
# correo solamente. Usar los UUID de customer_account.
PANEL_ALLOWED_ACCOUNT_IDS=00000000-0000-0000-0000-000000000000
NEXT_PUBLIC_SITE_URL=https://tu-dominio-confirmado.example

# Persistencia remota obligatoria para previews y producción en Vercel.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_API_TOKEN=
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# Integraciones opcionales: sus rutas responden 503 de forma segura si faltan.
ZERNIO_WEBHOOK_SECRET=
ZERNIO_API_KEY=
ZERNIO_API_BASE_URL=https://zernio.com/api
ANTHROPIC_API_KEY=

# Ajustes opcionales de límites por IP. Formato: TOPE o TOPE/MINUTOS.
# Si se omiten, se aplican los valores conservadores definidos por el servidor.
RATE_LIMIT_PUBLIC_SEARCH=30/10
RATE_LIMIT_PUBLIC_SIMULATION=30/10
RATE_LIMIT_PUBLIC_LEAD=10/10
RATE_LIMIT_PUBLIC_HANDOFF=10/10
RATE_LIMIT_PUBLIC_APPRAISAL=10/30
RATE_LIMIT_PUBLIC_APPRAISAL_PHOTO=30/30
RATE_LIMIT_PUBLIC_CONSIGNMENT=6/60
RATE_LIMIT_PUBLIC_CONSIGNMENT_PHOTO=30/60
RATE_LIMIT_PUBLIC_ACCOUNT_REGISTER=5/60
RATE_LIMIT_PUBLIC_ACCOUNT_LOGIN=12/10
RATE_LIMIT_PUBLIC_PASSPORT_REVIEW=20/10

# Opcional; minutos antes de retomar o compensar una reserva de foto de
# consignación incompleta. Rango permitido: 1 a 10080.
CONSIGNMENT_MEDIA_STALE_MINUTES=60
